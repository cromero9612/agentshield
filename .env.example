# Copiar a .env (NUNCA subir .env a GitHub)

# Vacio = Decider simulado (MockDecider). Con URL = modelo real.
# Ejemplo: http://IP-DE-LA-EC2:8000
DECIDER_URL=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
JUDGE_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Modelo del agente: bedrock (por defecto) u ollama (modelo local, NO es Bedrock)
AGENT_MODEL_PROVIDER=bedrock
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
